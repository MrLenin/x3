# This schema is a work in progress
#
# on debian, you would copy it to your /etc/ldap/schema directory, and add an include for it in ldap.conf
#
# OID arc note: the objectclass below was minted under 1.3.6.1.4.2.<"org.afternet"
# as ASCII decimal>. That parent arc is malformed -- private enterprise numbers live
# under 1.3.6.1.4.1, not .4.2. It is kept as-is because the objectclass is deployed
# and OIDs are opaque unique keys, not resolvable names; nothing breaks. New
# definitions extend the same arc for internal consistency (.1 = objectclasses,
# .2 = attributetypes). If evilnet ever registers a real PEN, correcting the whole
# arc is a single coordinated change, not a per-definition one.

attributetype  ( 1.3.6.1.4.2.111.114.103.46.97.102.116.101.114.110.101.116.2.1
     NAME 'X3AccountLevel'
          DESC 'X3 services OpServ privilege level (0-1000)'
     EQUALITY integerMatch
     ORDERING integerOrderingMatch
     SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
     SINGLE-VALUE
     )

objectclass    ( 1.3.6.1.4.2.111.114.103.46.97.102.116.101.114.110.101.116.1.10
     NAME 'inetOrgAnonAccount'
          DESC 'Anonymous Account'
     STRUCTURAL
         MAY (
             mail $ displayName $ uidNumber $ gidNumber $ cn $ sn $ givenName $
             userPassword $ title $ loginShell $ gecos $ displayName $
             X3AccountLevel )
         MUST (
             uid )
     )

